include README.md
include CHANGELOG.md
include CONTRIBUTING.md
include LICENSE
include SECURITY.md
include CITATION.cff
recursive-include docs *.md *.rst *.py *.html *.css
recursive-include docs/assets *.png *.json
recursive-include examples *.md *.py
recursive-include notebooks *.md *.py *.ipynb
recursive-include benchmarks *.md *.py
recursive-include tests *.py
global-exclude __pycache__ *.py[cod] .DS_Store

recursive-include resources *.json *.md
