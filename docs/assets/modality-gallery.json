        {
          "name": "ScatterSimulation",
          "params": {
            "fraction": 0.5,
            "sigma": 22.0,
            "p": 1.0,
            "seed": 7
          }
        },
        {
          "name": "GridArtifact",
          "params": {
            "amplitude": 0.16,
            "frequency": 0.16,
