{
  "synthetic": true,
  "environment": {
    "medaugmentx": "1.0.0",
    "numpy": "2.4.4",
    "scipy": "1.17.1",
    "matplotlib": "3.11.1"
  },
  "examples": [
    {
      "modality": "MRI",
      "display_limits": [
        0,
        1
      ],
      "shape": [
        256,
        256
      ],
      "spacing": [
        1.0,
        1.0
      ],
      "view": "Synthetic axial slice",
      "transforms": [
        {
          "name": "BiasField",
          "params": {
            "alpha": 0.65,
            "coarse_shape": 3,
            "order": 3,
            "p": 1.0,
            "seed": 7
          }
        },
        {
          "name": "RicianNoise",
          "params": {
            "std": 0.09,
            "clip": null,
            "p": 1.0,
            "seed": 7
          }
        }
      ]
    },
    {
      "modality": "CT",
      "display_limits": [
        -250,
        350
      ],
      "shape": [
        256,
        256
      ],
      "spacing": [
        1.0,
        1.0
      ],
      "view": "Synthetic axial slice",
      "transforms": [
        {
          "name": "BeamHardening",
