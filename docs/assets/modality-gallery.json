            "alpha": 0.1,
            "power": 2.0,
            "p": 1.0,
            "seed": 7
          }
        },
        {
          "name": "MetalStreak",
          "params": {
            "intensity": 0.16,
            "num_streaks": 9,
            "num_sources": 1,
            "falloff": 0.5,
